# Keystatic GitHub Integration (Optional - for production CMS access)
# Create a GitHub OAuth App: https://github.com/settings/apps/new
# Homepage URL: https://your-domain.com
# Callback URL: https://your-domain.com/api/keystatic/github/oauth/callback

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=  # Random 32-character string for session signing