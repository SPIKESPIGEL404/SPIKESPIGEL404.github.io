---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description}>
  <article class="max-w-3xl pt-8">
    <header class="mb-10">
      <span class="section-label">/ POST</span>
      <h1 class="mt-6 font-mono font-bold leading-tight" style="color:var(--ink);font-size:clamp(2rem,5vw,3.5rem)">
        {title}
      </h1>
      <time class="mt-4 inline-block font-mono text-xs uppercase tracking-wider" style="color:var(--muted)">
        {formattedDate}
      </time>
    </header>

    <div class="prose max-w-none">
      <slot />
    </div>

    <div class="mt-16 pt-6" style="border-top:1px solid var(--rule)">
      <a href="/writing" class="font-mono text-sm uppercase tracking-wider" style="color:var(--muted)">
        ← BACK TO WRITING
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  article a:hover { color: var(--ink) !important; }
</style>
