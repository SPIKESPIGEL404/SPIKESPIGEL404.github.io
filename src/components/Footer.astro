---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-800 bg-black">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <!-- Simple status -->
    <div class="mb-8">
      <p class="text-gray-300 font-mono text-sm text-center">
        Building things • Available for work
      </p>
    </div>

    <!-- Simple links -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8 text-sm font-mono">
      <a href="https://github.com/kelsenliu" target="_blank" rel="noopener noreferrer" 
         class="text-gray-400 hover:text-white transition-colors">
        GitHub
      </a>
      <a href="https://twitter.com/kelsenliu" target="_blank" rel="noopener noreferrer"
         class="text-gray-400 hover:text-white transition-colors">
        Twitter
      </a>
      <a href="mailto:hello@kelsenliu.com"
         class="text-gray-400 hover:text-white transition-colors">
        Email
      </a>
      <a href="https://github.com/SPIKESPIGEL404/SPIKESPIGEL404.github.io" target="_blank" rel="noopener noreferrer"
         class="text-gray-400 hover:text-white transition-colors">
        Source
      </a>
    </div>

    <!-- Copyright -->
    <div class="pt-6 border-t border-gray-800">
      <p class="text-gray-500 text-sm font-mono text-center">
        © {currentYear} kelsen.liu • built with astro + bun
      </p>
    </div>
  </div>
</footer>