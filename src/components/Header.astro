---
const currentPath = Astro.url.pathname;

const navItems = [
  { key: 'H', label: 'HOME', href: '/' },
  { key: 'W', label: 'WRITING', href: '/writing' },
  { key: 'P', label: 'PROJECTS', href: '/projects' },
  { key: 'A', label: 'ABOUT', href: '/about' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="fixed top-0 left-0 right-0 z-50" style="background:#f5f4ee;border-bottom:1px solid var(--rule)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <!-- Brand -->
      <a href="/" class="font-mono text-sm font-bold tracking-wider" style="color:var(--ink)">
        KELSEN.LIU
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6">
        {navItems.map((item) => (
          <a
            href={item.href}
            data-nav-key={item.key.toLowerCase()}
            class={`font-mono text-sm tracking-wider transition-colors ${isActive(item.href) ? 'is-active' : ''}`}
            style={isActive(item.href) ? 'color:var(--ink)' : 'color:var(--muted)'}
          >
            <span class="nav-key">[{item.key}]</span>{item.label}
          </a>
        ))}
      </nav>

      <!-- Mobile menu button -->
      <button id="mobile-menu-button" class="md:hidden" aria-label="Open menu">
        <div class="space-y-1.5">
          <span class="block w-5 h-px" style="background:var(--ink)"></span>
          <span class="block w-5 h-px" style="background:var(--ink)"></span>
          <span class="block w-5 h-px" style="background:var(--ink)"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav id="mobile-menu" class="hidden md:hidden" style="background:#f5f4ee;border-top:1px solid var(--rule)">
    <div class="px-4 py-3 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block px-2 py-2 font-mono text-sm tracking-wider"
          style={isActive(item.href) ? 'color:var(--ink)' : 'color:var(--muted)'}
        >
          <span class="nav-key">[{item.key}]</span>{item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  header nav a:hover {
    color: var(--ink) !important;
  }
  header nav a:hover .nav-key {
    color: var(--ink);
  }
</style>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  button?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  // Wire bracket-keys to nav: pressing the bracketed letter navigates.
  // Skip when typing in an input, when modifiers are held, or when text is being selected.
  const keyMap: Record<string, string> = {
    h: '/',
    w: '/writing',
    p: '/projects',
    a: '/about',
  };
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const tgt = e.target as HTMLElement | null;
    if (tgt && (tgt.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(tgt.tagName))) return;
    const dest = keyMap[e.key.toLowerCase()];
    if (!dest) return;
    e.preventDefault();
    if (window.location.pathname !== dest) window.location.href = dest;
  });
</script>
