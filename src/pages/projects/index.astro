---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
const activeProjects = projects.filter((p) => p.data.status === 'active');
const archivedProjects = projects.filter((p) => p.data.status === 'archived');
---

<BaseLayout title="Projects - Kelsen Liu">
  <section class="pt-8 pb-12">
    <h1 class="font-mono font-bold leading-[0.95] tracking-tight" style="color:var(--ink);font-size:clamp(3rem,9vw,7rem)">
      Projects
    </h1>
    <p class="mt-4 font-mono text-sm uppercase tracking-wider" style="color:var(--muted)">
      {activeProjects.length + archivedProjects.length} TOTAL · {activeProjects.length} ACTIVE · {archivedProjects.length} ARCHIVED
    </p>
  </section>

  {activeProjects.length === 0 && archivedProjects.length === 0 ? (
    <div class="card text-center py-12">
      <h2 class="text-xl font-mono mb-2" style="color:var(--ink)">No projects found</h2>
      <p class="text-sm font-mono" style="color:var(--muted)">Check back soon for updates</p>
    </div>
  ) : (
    <>
      {activeProjects.length > 0 && (
        <section class="mb-16">
          <span class="section-label">/ ACTIVE — ({activeProjects.length})</span>

          <div class="mt-6 grid md:grid-cols-2 gap-0" style="border-left:1px solid var(--rule);border-top:1px solid var(--rule)">
            {activeProjects.map((project) => (
              <article class="group p-6" style="border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)">
                <div class="flex items-start justify-between mb-3">
                  <h3 class="text-lg font-mono font-semibold" style="color:var(--ink)">
                    {project.data.name}
                  </h3>
                  <div class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider" style="color:var(--ink)">
                    <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:var(--ink)"></span>
                    ACTIVE
                  </div>
                </div>

                <p class="text-sm mb-5 leading-relaxed" style="color:var(--ink)">
                  {project.data.description}
                </p>

                <div class="flex gap-2">
                  {project.data.github && (
                    <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="btn">
                      <span class="nav-key">[G]</span>GITHUB
                    </a>
                  )}
                  {project.data.live && (
                    <a href={project.data.live} target="_blank" rel="noopener noreferrer" class="btn">
                      <span class="nav-key">[L]</span>LIVE
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {archivedProjects.length > 0 && (
        <section>
          <span class="section-label">/ ARCHIVED — ({archivedProjects.length})</span>

          <div class="mt-6 grid md:grid-cols-2 gap-0" style="border-left:1px solid var(--rule);border-top:1px solid var(--rule)">
            {archivedProjects.map((project) => (
              <article class="p-6" style="border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);opacity:0.65">
                <div class="flex items-start justify-between mb-3">
                  <h3 class="text-lg font-mono" style="color:var(--ink)">
                    {project.data.name}
                  </h3>
                  <div class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider" style="color:var(--muted)">
                    <span class="w-1.5 h-1.5 rounded-full" style="background:var(--muted)"></span>
                    ARCHIVED
                  </div>
                </div>

                <p class="text-sm mb-5 leading-relaxed" style="color:var(--muted)">
                  {project.data.description}
                </p>

                <div class="flex gap-2">
                  {project.data.github && (
                    <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="btn">
                      <span class="nav-key">[G]</span>GITHUB
                    </a>
                  )}
                  {project.data.live && (
                    <a href={project.data.live} target="_blank" rel="noopener noreferrer" class="btn">
                      <span class="nav-key">[V]</span>VIEW
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  <!-- CTA -->
  <section class="mt-20 pt-10" style="border-top:1px solid var(--rule)">
    <h3 class="font-mono text-2xl mb-2" style="color:var(--ink)">Interested in collaborating?</h3>
    <p class="font-mono text-sm" style="color:var(--muted)">
      <a href="mailto:hello@kelsenliu.com" class="underline underline-offset-4 hover:no-underline" style="color:var(--ink)">HELLO@KELSENLIU.COM</a>
      &nbsp;— LET'S BUILD SOMETHING.
    </p>
  </section>
</BaseLayout>
