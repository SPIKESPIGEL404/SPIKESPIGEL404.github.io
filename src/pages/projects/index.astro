---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const projects = await reader.collections.projects.all();

const activeProjects = projects.filter(p => p.entry.status === 'active');
const archivedProjects = projects.filter(p => p.entry.status === 'archived');
---

<BaseLayout title="Projects - Kelsen Liu">
  <!-- Header Section -->
  <section class="mb-16">
    <div class="terminal max-w-2xl">
      <div class="terminal-header">
        <div class="terminal-dots">
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
        </div>
        <span class="text-gray-400 text-xs font-mono">~/projects</span>
      </div>
      <div class="space-y-2">
        <p class="text-gray-300 font-mono text-sm">
          <span class="text-gray-500">$</span> ls -la projects/
        </p>
        <p class="text-white font-mono text-sm ml-4">
          total {activeProjects.length + archivedProjects.length} repositories
        </p>
        <p class="text-gray-300 font-mono text-sm ml-4">
          {activeProjects.length} active • {archivedProjects.length} archived
        </p>
        <div class="flex items-center mt-4">
          <span class="text-gray-300 font-mono text-sm">$</span>
          <span class="text-white font-mono text-sm ml-1 terminal-cursor">explore</span>
        </div>
      </div>
    </div>
  </section>

  {activeProjects.length === 0 && archivedProjects.length === 0 ? (
    <div class="card text-center py-12">
      <div class="text-6xl mb-4">🚀</div>
      <h2 class="text-xl font-mono text-white mb-2">No projects found</h2>
      <p class="text-gray-400 font-mono text-sm">
        <span class="text-gray-600">$</span> git clone future_projects.git
      </p>
    </div>
  ) : (
    <>
      {activeProjects.length > 0 && (
        <section class="mb-16">
          <h2 class="text-2xl font-bold text-white font-mono mb-8 flex items-center">
            <span class="text-white mr-2">></span>
            active_projects
            <span class="ml-4 text-gray-500 text-sm"># {activeProjects.length} repos</span>
          </h2>
          
          <div class="grid md:grid-cols-2 gap-6">
            {activeProjects.map((project) => (
              <article class="card group">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-xl font-mono text-white font-semibold transition-colors">
                    {project.entry.name}
                  </h3>
                  <div class="flex items-center space-x-1">
                    <div class="w-2 h-2 bg-white rounded-full animate-pulse"></div>
                    <span class="text-xs text-white font-mono">active</span>
                  </div>
                </div>
                
                <p class="text-gray-300 text-sm mb-4 leading-relaxed">
                  {project.entry.description}
                </p>
                
                <div class="flex gap-3 text-sm font-mono">
                  {project.entry.github && (
                    <a 
                      href={project.entry.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn flex items-center space-x-1"
                    >
                      <span>[gh]</span>
                      <span>Code</span>
                    </a>
                  )}
                  {project.entry.live && (
                    <a 
                      href={project.entry.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-gray-800 border border-gray-600 text-gray-300 px-4 py-2 rounded hover:bg-white hover:text-black transition-all duration-300 flex items-center space-x-1"
                    >
                      <span>[🔗]</span>
                      <span>Live</span>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
      
      {archivedProjects.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold text-gray-500 font-mono mb-8 flex items-center">
            <span class="text-gray-400 mr-2">></span>
            archived_projects
            <span class="ml-4 text-gray-600 text-sm"># {archivedProjects.length} repos</span>
          </h2>
          
          <div class="grid md:grid-cols-2 gap-6">
            {archivedProjects.map((project) => (
              <article class="bg-gray-900/30 border border-gray-700/50 rounded-lg p-6 backdrop-blur-sm opacity-75 hover:opacity-100 transition-opacity">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg font-mono text-gray-400 font-semibold">
                    {project.entry.name}
                  </h3>
                  <div class="flex items-center space-x-1">
                    <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
                    <span class="text-xs text-gray-400 font-mono">archived</span>
                  </div>
                </div>
                
                <p class="text-gray-500 text-sm mb-4 leading-relaxed">
                  {project.entry.description}
                </p>
                
                <div class="flex gap-3 text-sm font-mono">
                  {project.entry.github && (
                    <a 
                      href={project.entry.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-transparent border border-gray-600 text-gray-500 px-4 py-2 rounded hover:border-gray-400 hover:text-gray-300 transition-all duration-300 flex items-center space-x-1"
                    >
                      <span>[gh]</span>
                      <span>Code</span>
                    </a>
                  )}
                  {project.entry.live && (
                    <a 
                      href={project.entry.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-transparent border border-gray-600 text-gray-500 px-4 py-2 rounded hover:border-gray-400 hover:text-gray-300 transition-all duration-300 flex items-center space-x-1"
                    >
                      <span>[🔗]</span>
                      <span>Archive</span>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  <!-- Terminal command at bottom -->
  <section class="mt-16">
    <div class="terminal max-w-2xl">
      <div class="terminal-header">
        <div class="terminal-dots">
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
        </div>
        <span class="text-gray-400 text-xs font-mono">~/collaborate</span>
      </div>
      <div class="space-y-2">
        <p class="text-gray-300 font-mono text-sm">
          <span class="text-gray-500">$</span> echo "interested in collaborating?"
        </p>
        <p class="text-white font-mono text-sm ml-4">
          let's build something amazing together
        </p>
        <p class="text-gray-300 font-mono text-sm">
          <span class="text-gray-500">$</span> curl -X POST kelsen.liu/contact
        </p>
        <div class="flex items-center">
          <span class="text-gray-300 font-mono text-sm">$</span>
          <span class="text-gray-400 font-mono text-sm ml-1 animate-pulse">|</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>