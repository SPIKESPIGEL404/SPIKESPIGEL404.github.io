---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const posts = await reader.collections.posts.all();

const publishedPosts = posts
  .filter(post => !post.entry.draft)
  .sort((a, b) => {
    const dateA = new Date(a.entry.date).getTime();
    const dateB = new Date(b.entry.date).getTime();
    return dateB - dateA;
  });
---

<BaseLayout title="Writing - Kelsen Liu">
  <div class="space-y-8">
    <h1 class="text-5xl md:text-6xl font-bold text-white font-mono text-center mb-8">Writing</h1>
    
    {publishedPosts.length === 0 ? (
      <p class="text-gray-400 font-mono text-center">No posts yet.</p>
    ) : (
      <div class="space-y-6">
        {publishedPosts.map((post) => {
          const date = new Date(post.entry.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });
          
          return (
            <article>
              <a href={`/writing/${post.slug}`} class="block group">
                <h2 class="text-xl font-mono font-semibold mb-2 text-white group-hover:text-gray-300 transition-colors">
                  {post.entry.title}
                </h2>
                <p class="text-gray-400 mb-2">
                  {post.entry.description}
                </p>
                <time class="text-sm text-gray-500 font-mono">{date}</time>
              </a>
            </article>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>