---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();

const name = home?.name || 'Kelsen Liu';
const tagline = home?.tagline || 'Building things on the internet';
const links = home?.links || [];
---

<BaseLayout title={name}>
  <div class="space-y-8">
    <div>
      <h1 class="text-2xl font-bold mb-2">{name}</h1>
      <p class="text-zinc-600 dark:text-zinc-400">{tagline}</p>
    </div>
    
    {home?.bio && (
      <div class="text-zinc-600 dark:text-zinc-400">
        <p>{home.bio}</p>
      </div>
    )}
    
    {links.length > 0 && (
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {links.map((link) => (
          <a 
            href={link.url} 
            class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:underline"
            target={link.url?.startsWith('http') ? '_blank' : undefined}
            rel={link.url?.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    )}
  </div>
</BaseLayout>