---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();

const name = home?.name || 'Kelsen Liu';
const tagline = home?.tagline || 'Building things on the internet';
const links = home?.links || [];
---

<BaseLayout title={name}>
  <!-- Hero Section -->
  <section class="min-h-[80vh] flex items-center justify-center relative">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      <!-- Main title -->
      <div class="space-y-4">
        <h1 class="text-6xl md:text-8xl font-bold text-white font-mono">
          {name}
        </h1>
        <p class="text-xl md:text-2xl text-gray-400 font-mono">
          {tagline}
        </p>
        {home?.bio && (
          <p class="text-gray-300 font-sans text-lg max-w-2xl mx-auto mt-6">
            {home.bio}
          </p>
        )}
      </div>

      <!-- Status indicator -->
      <div class="flex items-center justify-center space-x-4 text-sm font-mono">
        <div class="flex items-center space-x-2 card px-4 py-2">
          <div class="w-2 h-2 bg-white rounded-full animate-pulse"></div>
          <span class="text-white">online</span>
        </div>
        <div class="flex items-center space-x-2 card px-4 py-2">
          <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
          <span class="text-gray-400">available for work</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Links Section -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-white font-mono mb-8">
        Explore My Work
      </h2>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {links.map((link) => (
          <a 
            href={link.url}
            target={link.url?.startsWith('http') ? '_blank' : undefined}
            rel={link.url?.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="card group"
          >
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-white font-mono font-semibold transition-colors">
                {link.label}
              </h3>
              <span class="text-gray-600 group-hover:text-white transition-colors text-2xl">
                →
              </span>
            </div>
            {link.url?.startsWith('http') && (
              <p class="text-gray-400 text-sm">
                External Link
              </p>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills/Tech Stack -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-white font-mono mb-8 text-center">
        Tech Stack
      </h2>
      <div class="grid md:grid-cols-2 gap-8 text-gray-300">
        <div>
          <h3 class="text-white font-mono text-lg mb-3">Languages</h3>
          <p class="font-mono text-sm">Rust, TypeScript, Python, Go</p>
        </div>
        <div>
          <h3 class="text-white font-mono text-lg mb-3">Frameworks</h3>
          <p class="font-mono text-sm">Astro, Next.js, SvelteKit, Axum</p>
        </div>
        <div>
          <h3 class="text-white font-mono text-lg mb-3">Tools</h3>
          <p class="font-mono text-sm">Bun, Docker, k8s, GitHub Actions</p>
        </div>
        <div>
          <h3 class="text-white font-mono text-lg mb-3">Databases</h3>
          <p class="font-mono text-sm">PostgreSQL, Redis, MongoDB</p>
        </div>
        <div>
          <h3 class="text-white font-mono text-lg mb-3">Cloud</h3>
          <p class="font-mono text-sm">AWS, Vercel, Railway, Fly.io</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>