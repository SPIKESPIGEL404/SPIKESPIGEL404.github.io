---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('pages', 'about');
const title = about?.data.title || 'About';
const { Content } = about ? await render(about) : { Content: null };
---

<BaseLayout title={`${title} - Kelsen Liu`}>
  <section class="pt-8 pb-12">
    <h1 class="font-mono font-bold leading-[0.95] tracking-tight" style="color:var(--ink);font-size:clamp(3rem,9vw,7rem)">
      {title}
    </h1>
  </section>

  <section>
    <span class="section-label">/ BIO</span>
    <div class="mt-6 max-w-3xl">
      {Content ? (
        <div class="prose max-w-none">
          <Content />
        </div>
      ) : (
        <p class="font-mono text-sm" style="color:var(--muted)">Content coming soon.</p>
      )}
    </div>
  </section>
</BaseLayout>
